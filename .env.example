# OpenRouter key: https://openrouter.ai/keys
# It is used for both the Grok roast and the Grok Imagine glow-up.
OPENROUTER_API_KEY=

# Set to 1 to rehearse with a sample roast and sample glow-up. No API calls.
MOCK=0

PORT=3000

# Glow-up quality on OpenRouter: low, medium, high, or auto.
# low is faster and cheaper for a live demo.
IMAGE_QUALITY=low

# Optional model overrides.
# ROAST_MODEL=x-ai/grok-4.7
# IMAGE_MODEL=x-ai/grok-imagine-image-2.0
