# openrouter (default, cheaper) or xai
PROVIDER=openrouter

# https://openrouter.ai/keys
# Used for the roast, and for the glow-up when PROVIDER=openrouter.
OPENROUTER_API_KEY=

# https://console.x.ai
# Required when PROVIDER=xai.
# Also used as the glow-up fallback when OpenRouter image generation fails.
XAI_API_KEY=

# Set to 1 to rehearse with a sample roast and sample glow-up. No API calls.
MOCK=0

PORT=3000

# xAI glow-up quality, and OpenRouter Grok Imagine if you select that image model.
# low is faster and cheaper. flux.2-klein-4b ignores this.
IMAGE_QUALITY=low

# Optional overrides. Defaults when unset:
#   openrouter roast: google/gemini-2.5-flash-lite
#   openrouter image: black-forest-labs/flux.2-klein-4b
#   xai roast: grok-4.7
#   xai image: grok-imagine-image-2.0
# ROAST_MODEL=
# IMAGE_MODEL=
